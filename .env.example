OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=smart-factory
NVIDIA_API_KEY=your_nvidia_api_key_here
JWT_SECRET=change_this_in_production_super_long_secret

# ── Runtime / governance ─────────────────────────────
# Run the Developer Agent through the NVIDIA NeMo Agent Toolkit ReAct agent
USE_NAT_DEVELOPER=true
NAT_MAX_TOOL_CALLS=16
# Hard token budget per workflow (orchestrator fails the workflow if exceeded)
MAX_WORKFLOW_TOKENS=500000
# Browser origins allowed to call the Nexus service directly (CORS)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Grafana admin credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin_secret

# ── Agent long-term memory (RAG via KBS) ─────────────────
ENABLE_AGENT_MEMORY=true
# Run extra agent roles through the NeMo (NAT) ReAct agent, e.g. reviewer,qa,architect,planner
USE_NAT_AGENTS=reviewer,qa

# ── Real deployment (DevOps agent runs a live preview container) ──
# SECURITY: turning this on mounts the host Docker socket into the runtime,
# which is root-equivalent host access. Only enable on a trusted host.
ENABLE_REAL_DEPLOY=true
DEPLOY_HOST=localhost
DEPLOY_PORT_MIN=9100
DEPLOY_PORT_MAX=9199
